{
  "rewrites": [
    { "source": "/cats", "destination": "/cats.html" },
    { "source": "/new", "destination": "/new.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/house/:path*", "destination": "/index.html" },
    { "source": "/:slug((?!assets|src|scripts|vendor|concepts)[^/.]+)", "destination": "/cat.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
